{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "eventFile",
      "type": "pickString",
      "description": "Selecciona el archivo de evento para invocar la Lambda",
      "options": [
        "events/api-gateway-event.json",
        "events/cloudwatch-scheduled-event.json",
        "events/dynamodb-event.json",
        "events/s3-event.json"
      ],
      "default": "events/cloudwatch-scheduled-event.json"
    },
    {
      "id": "awsProfile",
      "type": "promptString",
      "description": "Selecciona el perfil de AWS para invocar la Lambda",
      "default": "default"
    }
  ],
  "tasks": [
    {
      "label": "AWS SSO Login",
      "type": "shell",
      "command": "aws sso login --profile ${input:awsProfile} --use-device-code",
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Invocar Lambda",
      "type": "shell",
      "command": "sam local invoke LambdaFunction --event ${input:eventFile} | jq .",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Iniciar API Gateway",
      "type": "shell",
      "command": "sam local start-api",
      "problemMatcher": [],
      "group": "test",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
      }
    }
  ]
}